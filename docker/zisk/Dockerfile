# syntax=docker/dockerfile:1
# Context is generated by build.sh; it contains no credentials or test witnesses.
FROM rust:1.94.0-slim-bookworm@sha256:a86cada82e36ebd7a9bffed7548792c55a952fdb20718eea9278a936bcb76e62 AS client
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential pkg-config libssl-dev libclang-dev clang libgmp-dev \
    libsodium-dev libopenmpi-dev libprotobuf-dev protobuf-compiler nasm cmake \
    nlohmann-json3-dev libomp-dev libpqxx-dev libgrpc++-dev uuid-dev libsecp256k1-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY ethproofs/ ./
ARG BUILD_JOBS=8
# Guest input adapters do not need to rebuild the unrelated embedded guests.
# Upstream make auto-detects the build host's CPU. Keep the client at AVX2.
ENV SKIP_GUEST_BUILD=1 CARGO_INCREMENTAL=0 MAKEFLAGS="AVX512_SUPPORTED= AVX2_SUPPORTED=1"
RUN --mount=type=cache,target=/build/target \
    make -C vendor/proofman-starks-src clean_cpu && \
    cargo clean --release -p proofman-starks-lib-c && \
    cargo build --release --locked --offline --no-default-features --features monad -j "$BUILD_JOBS" && \
    install -Dm755 target/release/ethproofs-client /out/ethproofs-client

FROM nvidia/cuda:12.9.1-runtime-ubuntu24.04@sha256:1287141d283b8f06f45681b56a48a85791398c615888b1f96bfb9fc981392d98 AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl python3 openssh-server tmux tini procps iproute2 \
    libgomp1 libomp5 libgmp-dev libsodium23 libopenmpi3t64 openmpi-bin \
    libnuma1 libhwloc15 libssl3t64 libzstd1 build-essential nasm \
    && rm -rf /var/lib/apt/lists/*
COPY zisk/ /opt/zisk/
COPY --from=client /out/ethproofs-client /usr/local/bin/ethproofs-client
COPY monad-zkvm-zisk /opt/monad/monad-zkvm-zisk
COPY scripts/ /opt/monad/
COPY versions.json /opt/monad/versions.json
ENV ZISK_HOME=/opt/zisk ZISK_CACHE_DIR=/workspace/cache \
    PATH=/opt/zisk/bin:/opt/monad:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
RUN mkdir -p /workspace/inputs /workspace/runs /workspace/cache /run/sshd && \
    printf '%s\n' 'export ZISK_HOME=/opt/zisk ZISK_CACHE_DIR=/workspace/cache' \
      'export PATH=/opt/monad:/opt/zisk/bin:$PATH' > /etc/profile.d/monad-zisk.sh && \
    chmod +x /opt/monad/*.sh /opt/monad/witness.py && \
    ln -s /opt/zisk/bin/cargo-zisk-cpu /opt/zisk/bin/cargo-zisk && \
    ln -s /opt/zisk/bin/zisk-worker-gpu /opt/zisk/bin/zisk-worker && \
    /opt/monad/check-image.sh
ARG MONAD_REVISION
LABEL org.opencontainers.image.source="https://github.com/category-labs/monad" \
    org.opencontainers.image.title="Monad ZisK folder prover" \
    org.opencontainers.image.revision="$MONAD_REVISION" \
    org.opencontainers.image.version="1.3.1-alpha"
WORKDIR /workspace
# Vast SSH mode supplies its own SSH startup. No proving or key download at boot.
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["sleep", "infinity"]
