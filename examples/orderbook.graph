# process_orders_simple from example-models/json-models/process_orders.json:
# orders[t] (t = 0..9) is the quantity ordered of each of the order book's
# 10 x 10 items at time t, and an order is kept if every order of that item so
# far, itself included, fits in the book's quantity, and zeroed otherwise.
# ONNX's Less(remaining, 1) is Greater(1, remaining). As in the ONNX graph, the
# book and the scalar constants are broadcast by the ops that use them.
input order_book: int64[10, 10]
input orders: int64[10, 10, 10]

cumulative = cumsum(orders, 0)
remaining = sub(cumulative, order_book)
one = literal(int64[] 1)
fulfillable = greater(one, remaining)
zero = literal(int64[] 0)
result = where(fulfillable, orders, zero)
output result

# Book quantities in [0, 20] and orders in [0, 5], pseudo-random from fixed
# seeds, so some orders fit and some don't
call random_orders
    order_book = [
