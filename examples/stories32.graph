q_rotated2_0 = add(q_rotated2_0_cos, q_rotated2_0_sin)
k_rotated2_0_swapped = qmatmul(k_heads2_0, swap_pairs, 16, int32)
k_rotated2_0_cos = qmul(k_heads2_0, cos2, 16)
k_rotated2_0_sin = qmul(k_rotated2_0_swapped, sin2, 16)
k_rotated2_0 = add(k_rotated2_0_cos, k_rotated2_0_sin)
k_row2_0 = reshape(k_rotated2_0, [1, 4, 1, 8])
v_row2_0 = reshape(v2_0, [1, 4, 1, 8])
keys2_0 = concat(keys1_0, k_row2_0, 0)
values2_0 = concat(values1_0, v_row2_0, 0)
q_groups2_0 = reshape(q_rotated2_0, [4, 2, 8])
products2_0 = qmul(q_groups2_0, keys2_0, 16)
dots2_0 = reducesum(products2_0, 3)
scores2_0 = qmul(dots2_0, scale, 16)
top2_0 = reducemax(scores2_0, 0)
shifted2_0 = sub(scores2_0, top2_0)
exps2_0 = qexp(shifted2_0, 16)
total2_0 = reducesum(exps2_0, 0)
reciprocal2_0 = qdiv(one, total2_0, 16)
