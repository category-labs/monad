q0_2 = qmatmul(attention_in0_2, wq_2, 16, int32)
k0_2 = qmatmul(attention_in0_2, wk_2, 16, int32)
v0_2 = qmatmul(attention_in0_2, wv_2, 16, int32)
q_heads0_2 = reshape(q0_2, [8, 8])
k_heads0_2 = reshape(k0_2, [4, 8])
q_rotated0_2_swapped = qmatmul(q_heads0_2, swap_pairs, 16, int32)
q_rotated0_2_cos = qmul(q_heads0_2, cos0, 16)
q_rotated0_2_sin = qmul(q_rotated0_2_swapped, sin0, 16)
q_rotated0_2 = add(q_rotated0_2_cos, q_rotated0_2_sin)
k_rotated0_2_swapped = qmatmul(k_heads0_2, swap_pairs, 16, int32)
k_rotated0_2_cos = qmul(k_heads0_2, cos0, 16)
k_rotated0_2_sin = qmul(k_rotated0_2_swapped, sin0, 16)
k_rotated0_2 = add(k_rotated0_2_cos, k_rotated0_2_sin)
k_row0_2 = reshape(k_rotated0_2, [1, 4, 1, 8])
v_row0_2 = reshape(v0_2, [1, 4, 1, 8])
q_groups0_2 = reshape(q_rotated0_2, [4, 2, 8])
products0_2 = qmul(q_groups0_2, k_row0_2, 16)
dots0_2 = reducesum(products0_2, 3)
scores0_2 = qmul(dots0_2, scale, 16)
top0_2 = reducemax(scores0_2, 0)
shifted0_2 = sub(scores0_2, top0_2)
exps0_2 = qexp(shifted0_2, 16)
total0_2 = reducesum(exps0_2, 0)
reciprocal0_2 = qdiv(one, total0_2, 16)
attention_weights0_2 = qmul(exps0_2, reciprocal0_2, 16)
weighted0_2 = qmul(attention_weights0_2, v_row0_2, 16)
heads_out0_2 = reducesum(weighted0_2, 0)
attention0_2 = reshape(heads_out0_2, [1, 64])
projected0_2 = qmatmul(attention0_2, wo_2, 16, int32)
after_attention0_2 = add(projected0_2, after_mlp0_1)
# Position 0, layer 2: the MLP, w2(silu(w1(x)) * w3(x))
mlp_in0_2_squares = qmul(after_attention0_2, after_attention0_2, 16)
mlp_in0_2_total = reducesum(mlp_in0_2_squares, 1)
mlp_in0_2_mean = div(mlp_in0_2_total, 64)
mlp_in0_2_shifted = add(mlp_in0_2_mean, epsilon)
mlp_in0_2_scale = qinvsqrt(mlp_in0_2_shifted, 16)
mlp_in0_2_normed = qmul(after_attention0_2, mlp_in0_2_scale, 16)
mlp_in0_2 = qmul(mlp_in0_2_normed, rms_ffn_2, 16)
gate0_2 = qmatmul(mlp_in0_2, w1_2, 16, int32)
up0_2 = qmatmul(mlp_in0_2, w3_2, 16, int32)
activated0_2_negated = sub(zero, gate0_2)
activated0_2_minus_abs = min(gate0_2, activated0_2_negated)
activated0_2_a = qexp(activated0_2_minus_abs, 16)
activated0_2_denominator = add(one, activated0_2_a)
activated0_2_x_a = qmul(gate0_2, activated0_2_a, 16)
