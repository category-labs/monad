in_prompt12 = greater(length, position12)
token13 = where(in_prompt12, given12, likeliest12)
story12 = concat(story11, token13, 0)
# Position 13: its token's embedding, and its angles
position13 = literal(int32[1] [13])
cos13 = literal(int32[8] [59470, 59470, 17531, 17531, 64983, 64983, 65530, 65530])
sin13 = literal(int32[8] [-27536, 27536, -63148, 63148, -8496, 8496, -852, 852])
