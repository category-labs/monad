# Position 17: its token's embedding, and its angles
position17 = literal(int32[1] [17])
cos17 = literal(int32[8] [-18033, -18033, -8444, -8444, 64591, 64591, 65527, 65527])
sin17 = literal(int32[8] [63006, -63006, -64990, 64990, -11088, 11088, -1114, 1114])
