reciprocal15_0 = qdiv(one, total15_0, 16)
attention_weights15_0 = qmul(exps15_0, reciprocal15_0, 16)
weighted15_0 = qmul(attention_weights15_0, values15_0, 16)
heads_out15_0 = reducesum(weighted15_0, 0)
