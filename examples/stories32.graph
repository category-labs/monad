final0_mean = div(final0_total, 64)
final0_shifted = add(final0_mean, epsilon)
final0_scale = qinvsqrt(final0_shifted, 16)
final0_normed = qmul(after_mlp0_4, final0_scale, 16)
final0 = qmul(final0_normed, rms_final_0, 16)
final_column0 = reshape(final0, [64, 1])
logits0 = qmatmul(token_embeddings, final_column0, 16, int32)
likeliest0 = argmax(logits0)
given0 = gather(prompt, position0, 0)
in_prompt0 = greater(length, position0)
token1 = where(in_prompt0, given0, likeliest0)
# Position 1: its token's embedding, and its angles
position1 = literal(int32[1] [1])
cos1 = literal(int32[8] [35409, 35409, 65209, 65209, 65533, 65533, 65536, 65536])
sin1 = literal(int32[8] [-55147, 55147, -6543, 6543, -655, 655, -66, 66])
