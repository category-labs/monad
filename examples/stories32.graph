after_attention0_3 = add(projected0_3, after_mlp0_2)
# Position 0, layer 3: the MLP, w2(silu(w1(x)) * w3(x))
mlp_in0_3_squares = qmul(after_attention0_3, after_attention0_3, 16)
mlp_in0_3_total = reducesum(mlp_in0_3_squares, 1)
mlp_in0_3_mean = div(mlp_in0_3_total, 64)
