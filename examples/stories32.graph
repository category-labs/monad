q_rotated2_1_swapped = qmatmul(q_heads2_1, swap_pairs, 16, int32)
q_rotated2_1_cos = qmul(q_heads2_1, cos2, 16)
q_rotated2_1_sin = qmul(q_rotated2_1_swapped, sin2, 16)
q_rotated2_1 = add(q_rotated2_1_cos, q_rotated2_1_sin)
k_rotated2_1_swapped = qmatmul(k_heads2_1, swap_pairs, 16, int32)
k_rotated2_1_cos = qmul(k_heads2_1, cos2, 16)
k_rotated2_1_sin = qmul(k_rotated2_1_swapped, sin2, 16)
