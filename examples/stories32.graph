down15_4 = qmatmul(gated15_4, w2_4, 16, int32)
after_mlp15_4 = add(down15_4, after_attention15_4)
# Position 15: the next token, the prompt's if it has one there, otherwise the likeliest. The classifier is the embeddings
final15_squares = qmul(after_mlp15_4, after_mlp15_4, 16)
final15_total = reducesum(final15_squares, 1)
final15_mean = div(final15_total, 64)
