likeliest13 = argmax(logits13)
given13 = gather(prompt, position13, 0)
in_prompt13 = greater(length, position13)
token14 = where(in_prompt13, given13, likeliest13)
story13 = concat(story12, token14, 0)
# Position 14: its token's embedding, and its angles
position14 = literal(int32[1] [14])
cos14 = literal(int32[8] [8961, 8961, 11139, 11139, 64895, 64895, 65530, 65530])
sin14 = literal(int32[8] [-64920, 64920, -64582, 64582, -9145, 9145, -917, 917])
embedding14 = gather(token_embeddings, token14, 0)
# Position 14, layer 0: attention over positions 0 to 14
attention_in14_0_squares = qmul(embedding14, embedding14, 16)
attention_in14_0_total = reducesum(attention_in14_0_squares, 1)
attention_in14_0_mean = div(attention_in14_0_total, 64)
attention_in14_0_shifted = add(attention_in14_0_mean, epsilon)
attention_in14_0_scale = qinvsqrt(attention_in14_0_shifted, 16)
attention_in14_0_normed = qmul(embedding14, attention_in14_0_scale, 16)
attention_in14_0 = qmul(attention_in14_0_normed, rms_att_0, 16)
q14_0 = qmatmul(attention_in14_0, wq_0, 16, int32)
k14_0 = qmatmul(attention_in14_0, wk_0, 16, int32)
v14_0 = qmatmul(attention_in14_0, wv_0, 16, int32)
q_heads14_0 = reshape(q14_0, [8, 8])
k_heads14_0 = reshape(k14_0, [4, 8])
q_rotated14_0_swapped = qmatmul(q_heads14_0, swap_pairs, 16, int32)
q_rotated14_0_cos = qmul(q_heads14_0, cos14, 16)
q_rotated14_0_sin = qmul(q_rotated14_0_swapped, sin14, 16)
q_rotated14_0 = add(q_rotated14_0_cos, q_rotated14_0_sin)
k_rotated14_0_swapped = qmatmul(k_heads14_0, swap_pairs, 16, int32)
k_rotated14_0_cos = qmul(k_heads14_0, cos14, 16)
k_rotated14_0_sin = qmul(k_rotated14_0_swapped, sin14, 16)
k_rotated14_0 = add(k_rotated14_0_cos, k_rotated14_0_sin)
k_row14_0 = reshape(k_rotated14_0, [1, 4, 1, 8])
v_row14_0 = reshape(v14_0, [1, 4, 1, 8])
keys14_0 = concat(keys13_0, k_row14_0, 0)
values14_0 = concat(values13_0, v_row14_0, 0)
q_groups14_0 = reshape(q_rotated14_0, [4, 2, 8])
products14_0 = qmul(q_groups14_0, keys14_0, 16)
dots14_0 = reducesum(products14_0, 3)
scores14_0 = qmul(dots14_0, scale, 16)
top14_0 = reducemax(scores14_0, 0)
shifted14_0 = sub(scores14_0, top14_0)
exps14_0 = qexp(shifted14_0, 16)
total14_0 = reducesum(exps14_0, 0)
reciprocal14_0 = qdiv(one, total14_0, 16)
attention_weights14_0 = qmul(exps14_0, reciprocal14_0, 16)
weighted14_0 = qmul(attention_weights14_0, values14_0, 16)
heads_out14_0 = reducesum(weighted14_0, 0)
attention14_0 = reshape(heads_out14_0, [1, 64])
projected14_0 = qmatmul(attention14_0, wo_0, 16, int32)
after_attention14_0 = add(projected14_0, embedding14)
# Position 14, layer 0: the MLP, w2(silu(w1(x)) * w3(x))
