k_rotated0_0_cos = qmul(k_heads0_0, cos0, 16)
k_rotated0_0_sin = qmul(k_rotated0_0_swapped, sin0, 16)
k_rotated0_0 = add(k_rotated0_0_cos, k_rotated0_0_sin)
k_row0_0 = reshape(k_rotated0_0, [1, 4, 1, 8])
v_row0_0 = reshape(v0_0, [1, 4, 1, 8])
q_groups0_0 = reshape(q_rotated0_0, [4, 2, 8])
products0_0 = qmul(q_groups0_0, k_row0_0, 16)
dots0_0 = reducesum(products0_0, 3)
scores0_0 = qmul(dots0_0, scale, 16)
top0_0 = reducemax(scores0_0, 0)
shifted0_0 = sub(scores0_0, top0_0)
exps0_0 = qexp(shifted0_0, 16)
