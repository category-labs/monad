reciprocal0_0 = qdiv(one, total0_0, 16)
attention_weights0_0 = qmul(exps0_0, reciprocal0_0, 16)
weighted0_0 = qmul(attention_weights0_0, v_row0_0, 16)
heads_out0_0 = reducesum(weighted0_0, 0)
