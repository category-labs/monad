q_rotated0_3_cos = qmul(q_heads0_3, cos0, 16)
q_rotated0_3_sin = qmul(q_rotated0_3_swapped, sin0, 16)
q_rotated0_3 = add(q_rotated0_3_cos, q_rotated0_3_sin)
k_rotated0_3_swapped = qmatmul(k_heads0_3, swap_pairs, 16, int32)
k_rotated0_3_cos = qmul(k_heads0_3, cos0, 16)
k_rotated0_3_sin = qmul(k_rotated0_3_swapped, sin0, 16)
k_rotated0_3 = add(k_rotated0_3_cos, k_rotated0_3_sin)
k_row0_3 = reshape(k_rotated0_3, [1, 4, 1, 8])
v_row0_3 = reshape(v0_3, [1, 4, 1, 8])
q_groups0_3 = reshape(q_rotated0_3, [4, 2, 8])
products0_3 = qmul(q_groups0_3, k_row0_3, 16)
dots0_3 = reducesum(products0_3, 3)
scores0_3 = qmul(dots0_3, scale, 16)
top0_3 = reducemax(scores0_3, 0)
