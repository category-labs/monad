v_row1_0 = reshape(v1_0, [1, 4, 1, 8])
keys1_0 = concat(k_row0_0, k_row1_0, 0)
values1_0 = concat(v_row0_0, v_row1_0, 0)
q_groups1_0 = reshape(q_rotated1_0, [4, 2, 8])
