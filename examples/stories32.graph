# Position 2, layer 1: attention over positions 0 to 2
attention_in2_1_squares = qmul(after_mlp2_0, after_mlp2_0, 16)
attention_in2_1_total = reducesum(attention_in2_1_squares, 1)
attention_in2_1_mean = div(attention_in2_1_total, 64)
attention_in2_1_shifted = add(attention_in2_1_mean, epsilon)
attention_in2_1_scale = qinvsqrt(attention_in2_1_shifted, 16)
attention_in2_1_normed = qmul(after_mlp2_0, attention_in2_1_scale, 16)
attention_in2_1 = qmul(attention_in2_1_normed, rms_att_1, 16)
q2_1 = qmatmul(attention_in2_1, wq_1, 16, int32)
k2_1 = qmatmul(attention_in2_1, wk_1, 16, int32)
