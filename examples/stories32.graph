projected0_0 = qmatmul(attention0_0, wo_0, 16, int32)
after_attention0_0 = add(projected0_0, embedding0)
# Position 0, layer 0: the MLP, w2(silu(w1(x)) * w3(x))
mlp_in0_0_squares = qmul(after_attention0_0, after_attention0_0, 16)
mlp_in0_0_total = reducesum(mlp_in0_0_squares, 1)
