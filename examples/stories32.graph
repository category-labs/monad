mlp_in14_0_normed = qmul(after_attention14_0, mlp_in14_0_scale, 16)
mlp_in14_0 = qmul(mlp_in14_0_normed, rms_ffn_0, 16)
gate14_0 = qmatmul(mlp_in14_0, w1_0, 16, int32)
up14_0 = qmatmul(mlp_in14_0, w3_0, 16, int32)
