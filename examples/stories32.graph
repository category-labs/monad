after_mlp0_4 = add(down0_4, after_attention0_4)
# Position 0: the next token, the prompt's if it has one there, otherwise the likeliest. The classifier is the embeddings
final0_squares = qmul(after_mlp0_4, after_mlp0_4, 16)
