v0_0 = qmatmul(attention_in0_0, wv_0, 16, int32)
q_heads0_0 = reshape(q0_0, [8, 8])
k_heads0_0 = reshape(k0_0, [4, 8])
q_rotated0_0_swapped = qmatmul(q_heads0_0, swap_pairs, 16, int32)
q_rotated0_0_cos = qmul(q_heads0_0, cos0, 16)
