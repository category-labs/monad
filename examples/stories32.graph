k_rotated21_4_cos = qmul(k_heads21_4, cos21, 16)
k_rotated21_4_sin = qmul(k_rotated21_4_swapped, sin21, 16)
k_rotated21_4 = add(k_rotated21_4_cos, k_rotated21_4_sin)
k_row21_4 = reshape(k_rotated21_4, [1, 4, 1, 8])
v_row21_4 = reshape(v21_4, [1, 4, 1, 8])
keys21_4 = concat(keys20_4, k_row21_4, 0)
values21_4 = concat(values20_4, v_row21_4, 0)
q_groups21_4 = reshape(q_rotated21_4, [4, 2, 8])
products21_4 = qmul(q_groups21_4, keys21_4, 16)
