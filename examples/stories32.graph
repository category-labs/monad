mlp_in0_3 = qmul(mlp_in0_3_normed, rms_ffn_3, 16)
gate0_3 = qmatmul(mlp_in0_3, w1_3, 16, int32)
up0_3 = qmatmul(mlp_in0_3, w3_3, 16, int32)
activated0_3_negated = sub(zero, gate0_3)
activated0_3_minus_abs = min(gate0_3, activated0_3_negated)
