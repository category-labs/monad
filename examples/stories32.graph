products0_1 = qmul(q_groups0_1, k_row0_1, 16)
dots0_1 = reducesum(products0_1, 3)
scores0_1 = qmul(dots0_1, scale, 16)
top0_1 = reducemax(scores0_1, 0)
shifted0_1 = sub(scores0_1, top0_1)
