activated24_3_negated = sub(zero, gate24_3)
activated24_3_minus_abs = min(gate24_3, activated24_3_negated)
activated24_3_a = qexp(activated24_3_minus_abs, 16)
activated24_3_denominator = add(one, activated24_3_a)
activated24_3_x_a = qmul(gate24_3, activated24_3_a, 16)
activated24_3_positive = ge(gate24_3, zero)
