heads_out1_1 = reducesum(weighted1_1, 0)
attention1_1 = reshape(heads_out1_1, [1, 64])
projected1_1 = qmatmul(attention1_1, wo_1, 16, int32)
after_attention1_1 = add(projected1_1, after_mlp1_0)
# Position 1, layer 1: the MLP, w2(silu(w1(x)) * w3(x))
mlp_in1_1_squares = qmul(after_attention1_1, after_attention1_1, 16)
mlp_in1_1_total = reducesum(mlp_in1_1_squares, 1)
mlp_in1_1_mean = div(mlp_in1_1_total, 64)
mlp_in1_1_shifted = add(mlp_in1_1_mean, epsilon)
mlp_in1_1_scale = qinvsqrt(mlp_in1_1_shifted, 16)
mlp_in1_1_normed = qmul(after_attention1_1, mlp_in1_1_scale, 16)
mlp_in1_1 = qmul(mlp_in1_1_normed, rms_ffn_1, 16)
gate1_1 = qmatmul(mlp_in1_1, w1_1, 16, int32)
up1_1 = qmatmul(mlp_in1_1, w3_1, 16, int32)
activated1_1_negated = sub(zero, gate1_1)
activated1_1_minus_abs = min(gate1_1, activated1_1_negated)
activated1_1_a = qexp(activated1_1_minus_abs, 16)
activated1_1_denominator = add(one, activated1_1_a)
activated1_1_x_a = qmul(gate1_1, activated1_1_a, 16)
activated1_1_positive = ge(gate1_1, zero)
activated1_1_numerator = where(activated1_1_positive, gate1_1, activated1_1_x_a)
activated1_1 = qdiv(activated1_1_numerator, activated1_1_denominator, 16)
gated1_1 = qmul(activated1_1, up1_1, 16)
down1_1 = qmatmul(gated1_1, w2_1, 16, int32)
after_mlp1_1 = add(down1_1, after_attention1_1)
# Position 1, layer 2: attention over positions 0 to 1
attention_in1_2_squares = qmul(after_mlp1_1, after_mlp1_1, 16)
attention_in1_2_total = reducesum(attention_in1_2_squares, 1)
attention_in1_2_mean = div(attention_in1_2_total, 64)
attention_in1_2_shifted = add(attention_in1_2_mean, epsilon)
attention_in1_2_scale = qinvsqrt(attention_in1_2_shifted, 16)
attention_in1_2_normed = qmul(after_mlp1_1, attention_in1_2_scale, 16)
attention_in1_2 = qmul(attention_in1_2_normed, rms_att_2, 16)
q1_2 = qmatmul(attention_in1_2, wq_2, 16, int32)
k1_2 = qmatmul(attention_in1_2, wk_2, 16, int32)
v1_2 = qmatmul(attention_in1_2, wv_2, 16, int32)
q_heads1_2 = reshape(q1_2, [8, 8])
k_heads1_2 = reshape(k1_2, [4, 8])
q_rotated1_2_swapped = qmatmul(q_heads1_2, swap_pairs, 16, int32)
q_rotated1_2_cos = qmul(q_heads1_2, cos1, 16)
q_rotated1_2_sin = qmul(q_rotated1_2_swapped, sin1, 16)
q_rotated1_2 = add(q_rotated1_2_cos, q_rotated1_2_sin)
k_rotated1_2_swapped = qmatmul(k_heads1_2, swap_pairs, 16, int32)
k_rotated1_2_cos = qmul(k_heads1_2, cos1, 16)
k_rotated1_2_sin = qmul(k_rotated1_2_swapped, sin1, 16)
k_rotated1_2 = add(k_rotated1_2_cos, k_rotated1_2_sin)
k_row1_2 = reshape(k_rotated1_2, [1, 4, 1, 8])
v_row1_2 = reshape(v1_2, [1, 4, 1, 8])
keys1_2 = concat(k_row0_2, k_row1_2, 0)
values1_2 = concat(v_row0_2, v_row1_2, 0)
q_groups1_2 = reshape(q_rotated1_2, [4, 2, 8])
products1_2 = qmul(q_groups1_2, keys1_2, 16)
dots1_2 = reducesum(products1_2, 3)
scores1_2 = qmul(dots1_2, scale, 16)
top1_2 = reducemax(scores1_2, 0)
shifted1_2 = sub(scores1_2, top1_2)
exps1_2 = qexp(shifted1_2, 16)
total1_2 = reducesum(exps1_2, 0)
reciprocal1_2 = qdiv(one, total1_2, 16)
attention_weights1_2 = qmul(exps1_2, reciprocal1_2, 16)
weighted1_2 = qmul(attention_weights1_2, values1_2, 16)
heads_out1_2 = reducesum(weighted1_2, 0)
attention1_2 = reshape(heads_out1_2, [1, 64])
projected1_2 = qmatmul(attention1_2, wo_2, 16, int32)
after_attention1_2 = add(projected1_2, after_mlp1_1)
# Position 1, layer 2: the MLP, w2(silu(w1(x)) * w3(x))
mlp_in1_2_squares = qmul(after_attention1_2, after_attention1_2, 16)
mlp_in1_2_total = reducesum(mlp_in1_2_squares, 1)
mlp_in1_2_mean = div(mlp_in1_2_total, 64)
mlp_in1_2_shifted = add(mlp_in1_2_mean, epsilon)
mlp_in1_2_scale = qinvsqrt(mlp_in1_2_shifted, 16)
mlp_in1_2_normed = qmul(after_attention1_2, mlp_in1_2_scale, 16)
mlp_in1_2 = qmul(mlp_in1_2_normed, rms_ffn_2, 16)
gate1_2 = qmatmul(mlp_in1_2, w1_2, 16, int32)
up1_2 = qmatmul(mlp_in1_2, w3_2, 16, int32)
activated1_2_negated = sub(zero, gate1_2)
activated1_2_minus_abs = min(gate1_2, activated1_2_negated)
activated1_2_a = qexp(activated1_2_minus_abs, 16)
activated1_2_denominator = add(one, activated1_2_a)
activated1_2_x_a = qmul(gate1_2, activated1_2_a, 16)
activated1_2_positive = ge(gate1_2, zero)
activated1_2_numerator = where(activated1_2_positive, gate1_2, activated1_2_x_a)
activated1_2 = qdiv(activated1_2_numerator, activated1_2_denominator, 16)
gated1_2 = qmul(activated1_2, up1_2, 16)
down1_2 = qmatmul(gated1_2, w2_2, 16, int32)
after_mlp1_2 = add(down1_2, after_attention1_2)
# Position 1, layer 3: attention over positions 0 to 1
attention_in1_3_squares = qmul(after_mlp1_2, after_mlp1_2, 16)
attention_in1_3_total = reducesum(attention_in1_3_squares, 1)
attention_in1_3_mean = div(attention_in1_3_total, 64)
attention_in1_3_shifted = add(attention_in1_3_mean, epsilon)
attention_in1_3_scale = qinvsqrt(attention_in1_3_shifted, 16)
attention_in1_3_normed = qmul(after_mlp1_2, attention_in1_3_scale, 16)
attention_in1_3 = qmul(attention_in1_3_normed, rms_att_3, 16)
q1_3 = qmatmul(attention_in1_3, wq_3, 16, int32)
k1_3 = qmatmul(attention_in1_3, wk_3, 16, int32)
v1_3 = qmatmul(attention_in1_3, wv_3, 16, int32)
q_heads1_3 = reshape(q1_3, [8, 8])
k_heads1_3 = reshape(k1_3, [4, 8])
q_rotated1_3_swapped = qmatmul(q_heads1_3, swap_pairs, 16, int32)
q_rotated1_3_cos = qmul(q_heads1_3, cos1, 16)
q_rotated1_3_sin = qmul(q_rotated1_3_swapped, sin1, 16)
q_rotated1_3 = add(q_rotated1_3_cos, q_rotated1_3_sin)
k_rotated1_3_swapped = qmatmul(k_heads1_3, swap_pairs, 16, int32)
k_rotated1_3_cos = qmul(k_heads1_3, cos1, 16)
k_rotated1_3_sin = qmul(k_rotated1_3_swapped, sin1, 16)
k_rotated1_3 = add(k_rotated1_3_cos, k_rotated1_3_sin)
k_row1_3 = reshape(k_rotated1_3, [1, 4, 1, 8])
v_row1_3 = reshape(v1_3, [1, 4, 1, 8])
keys1_3 = concat(k_row0_3, k_row1_3, 0)
values1_3 = concat(v_row0_3, v_row1_3, 0)
q_groups1_3 = reshape(q_rotated1_3, [4, 2, 8])
products1_3 = qmul(q_groups1_3, keys1_3, 16)
dots1_3 = reducesum(products1_3, 3)
scores1_3 = qmul(dots1_3, scale, 16)
top1_3 = reducemax(scores1_3, 0)
shifted1_3 = sub(scores1_3, top1_3)
exps1_3 = qexp(shifted1_3, 16)
total1_3 = reducesum(exps1_3, 0)
reciprocal1_3 = qdiv(one, total1_3, 16)
attention_weights1_3 = qmul(exps1_3, reciprocal1_3, 16)
weighted1_3 = qmul(attention_weights1_3, values1_3, 16)
heads_out1_3 = reducesum(weighted1_3, 0)
attention1_3 = reshape(heads_out1_3, [1, 64])
projected1_3 = qmatmul(attention1_3, wo_3, 16, int32)
after_attention1_3 = add(projected1_3, after_mlp1_2)
# Position 1, layer 3: the MLP, w2(silu(w1(x)) * w3(x))
mlp_in1_3_squares = qmul(after_attention1_3, after_attention1_3, 16)
mlp_in1_3_total = reducesum(mlp_in1_3_squares, 1)
mlp_in1_3_mean = div(mlp_in1_3_total, 64)
mlp_in1_3_shifted = add(mlp_in1_3_mean, epsilon)
mlp_in1_3_scale = qinvsqrt(mlp_in1_3_shifted, 16)
mlp_in1_3_normed = qmul(after_attention1_3, mlp_in1_3_scale, 16)
mlp_in1_3 = qmul(mlp_in1_3_normed, rms_ffn_3, 16)
gate1_3 = qmatmul(mlp_in1_3, w1_3, 16, int32)
up1_3 = qmatmul(mlp_in1_3, w3_3, 16, int32)
activated1_3_negated = sub(zero, gate1_3)
activated1_3_minus_abs = min(gate1_3, activated1_3_negated)
activated1_3_a = qexp(activated1_3_minus_abs, 16)
activated1_3_denominator = add(one, activated1_3_a)
activated1_3_x_a = qmul(gate1_3, activated1_3_a, 16)
activated1_3_positive = ge(gate1_3, zero)
activated1_3_numerator = where(activated1_3_positive, gate1_3, activated1_3_x_a)
activated1_3 = qdiv(activated1_3_numerator, activated1_3_denominator, 16)
gated1_3 = qmul(activated1_3, up1_3, 16)
down1_3 = qmatmul(gated1_3, w2_3, 16, int32)
after_mlp1_3 = add(down1_3, after_attention1_3)
# Position 1, layer 4: attention over positions 0 to 1
attention_in1_4_squares = qmul(after_mlp1_3, after_mlp1_3, 16)
attention_in1_4_total = reducesum(attention_in1_4_squares, 1)
attention_in1_4_mean = div(attention_in1_4_total, 64)
attention_in1_4_shifted = add(attention_in1_4_mean, epsilon)
attention_in1_4_scale = qinvsqrt(attention_in1_4_shifted, 16)
attention_in1_4_normed = qmul(after_mlp1_3, attention_in1_4_scale, 16)
attention_in1_4 = qmul(attention_in1_4_normed, rms_att_4, 16)
q1_4 = qmatmul(attention_in1_4, wq_4, 16, int32)
k1_4 = qmatmul(attention_in1_4, wk_4, 16, int32)
v1_4 = qmatmul(attention_in1_4, wv_4, 16, int32)
q_heads1_4 = reshape(q1_4, [8, 8])
k_heads1_4 = reshape(k1_4, [4, 8])
q_rotated1_4_swapped = qmatmul(q_heads1_4, swap_pairs, 16, int32)
q_rotated1_4_cos = qmul(q_heads1_4, cos1, 16)
q_rotated1_4_sin = qmul(q_rotated1_4_swapped, sin1, 16)
q_rotated1_4 = add(q_rotated1_4_cos, q_rotated1_4_sin)
k_rotated1_4_swapped = qmatmul(k_heads1_4, swap_pairs, 16, int32)
k_rotated1_4_cos = qmul(k_heads1_4, cos1, 16)
k_rotated1_4_sin = qmul(k_rotated1_4_swapped, sin1, 16)
k_rotated1_4 = add(k_rotated1_4_cos, k_rotated1_4_sin)
k_row1_4 = reshape(k_rotated1_4, [1, 4, 1, 8])
v_row1_4 = reshape(v1_4, [1, 4, 1, 8])
keys1_4 = concat(k_row0_4, k_row1_4, 0)
values1_4 = concat(v_row0_4, v_row1_4, 0)
q_groups1_4 = reshape(q_rotated1_4, [4, 2, 8])
products1_4 = qmul(q_groups1_4, keys1_4, 16)
dots1_4 = reducesum(products1_4, 3)
scores1_4 = qmul(dots1_4, scale, 16)
top1_4 = reducemax(scores1_4, 0)
shifted1_4 = sub(scores1_4, top1_4)
exps1_4 = qexp(shifted1_4, 16)
total1_4 = reducesum(exps1_4, 0)
reciprocal1_4 = qdiv(one, total1_4, 16)
attention_weights1_4 = qmul(exps1_4, reciprocal1_4, 16)
weighted1_4 = qmul(attention_weights1_4, values1_4, 16)
heads_out1_4 = reducesum(weighted1_4, 0)
attention1_4 = reshape(heads_out1_4, [1, 64])
projected1_4 = qmatmul(attention1_4, wo_4, 16, int32)
after_attention1_4 = add(projected1_4, after_mlp1_3)
# Position 1, layer 4: the MLP, w2(silu(w1(x)) * w3(x))
mlp_in1_4_squares = qmul(after_attention1_4, after_attention1_4, 16)
mlp_in1_4_total = reducesum(mlp_in1_4_squares, 1)
mlp_in1_4_mean = div(mlp_in1_4_total, 64)
mlp_in1_4_shifted = add(mlp_in1_4_mean, epsilon)
mlp_in1_4_scale = qinvsqrt(mlp_in1_4_shifted, 16)
mlp_in1_4_normed = qmul(after_attention1_4, mlp_in1_4_scale, 16)
mlp_in1_4 = qmul(mlp_in1_4_normed, rms_ffn_4, 16)
gate1_4 = qmatmul(mlp_in1_4, w1_4, 16, int32)
up1_4 = qmatmul(mlp_in1_4, w3_4, 16, int32)
activated1_4_negated = sub(zero, gate1_4)
activated1_4_minus_abs = min(gate1_4, activated1_4_negated)
activated1_4_a = qexp(activated1_4_minus_abs, 16)
activated1_4_denominator = add(one, activated1_4_a)
activated1_4_x_a = qmul(gate1_4, activated1_4_a, 16)
activated1_4_positive = ge(gate1_4, zero)
activated1_4_numerator = where(activated1_4_positive, gate1_4, activated1_4_x_a)
activated1_4 = qdiv(activated1_4_numerator, activated1_4_denominator, 16)
gated1_4 = qmul(activated1_4, up1_4, 16)
down1_4 = qmatmul(gated1_4, w2_4, 16, int32)
after_mlp1_4 = add(down1_4, after_attention1_4)
# Position 1: the next token, the prompt's if it has one there, otherwise the likeliest. The classifier is the embeddings
final1_squares = qmul(after_mlp1_4, after_mlp1_4, 16)
final1_total = reducesum(final1_squares, 1)
final1_mean = div(final1_total, 64)
final1_shifted = add(final1_mean, epsilon)
final1_scale = qinvsqrt(final1_shifted, 16)
final1_normed = qmul(after_mlp1_4, final1_scale, 16)
final1 = qmul(final1_normed, rms_final_0, 16)
final_column1 = reshape(final1, [64, 1])
logits1 = qmatmul(token_embeddings, final_column1, 16, int32)
likeliest1 = argmax(logits1)
given1 = gather(prompt, position1, 0)
in_prompt1 = greater(length, position1)
token2 = where(in_prompt1, given1, likeliest1)
story1 = concat(token1, token2, 0)
# Position 2: its token's embedding, and its angles
position2 = literal(int32[1] [2])
cos2 = literal(int32[8] [-27273, -27273, 64230, 64230, 65523, 65523, 65536, 65536])
sin2 = literal(int32[8] [-59592, 59592, -13020, 13020, -1311, 1311, -131, 131])
embedding2 = gather(token_embeddings, token2, 0)
# Position 2, layer 0: attention over positions 0 to 2
attention_in2_0_squares = qmul(embedding2, embedding2, 16)
