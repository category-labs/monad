k_rotated0_4_cos = qmul(k_heads0_4, cos0, 16)
k_rotated0_4_sin = qmul(k_rotated0_4_swapped, sin0, 16)
k_rotated0_4 = add(k_rotated0_4_cos, k_rotated0_4_sin)
k_row0_4 = reshape(k_rotated0_4, [1, 4, 1, 8])
v_row0_4 = reshape(v0_4, [1, 4, 1, 8])
q_groups0_4 = reshape(q_rotated0_4, [4, 2, 8])
products0_4 = qmul(q_groups0_4, k_row0_4, 16)
