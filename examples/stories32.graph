weighted2_0 = qmul(attention_weights2_0, values2_0, 16)
heads_out2_0 = reducesum(weighted2_0, 0)
attention2_0 = reshape(heads_out2_0, [1, 64])
projected2_0 = qmatmul(attention2_0, wo_0, 16, int32)
after_attention2_0 = add(projected2_0, embedding2)
# Position 2, layer 0: the MLP, w2(silu(w1(x)) * w3(x))
mlp_in2_0_squares = qmul(after_attention2_0, after_attention2_0, 16)
mlp_in2_0_total = reducesum(mlp_in2_0_squares, 1)
mlp_in2_0_mean = div(mlp_in2_0_total, 64)
mlp_in2_0_shifted = add(mlp_in2_0_mean, epsilon)
mlp_in2_0_scale = qinvsqrt(mlp_in2_0_shifted, 16)
mlp_in2_0_normed = qmul(after_attention2_0, mlp_in2_0_scale, 16)
mlp_in2_0 = qmul(mlp_in2_0_normed, rms_ffn_0, 16)
gate2_0 = qmatmul(mlp_in2_0, w1_0, 16, int32)
up2_0 = qmatmul(mlp_in2_0, w3_0, 16, int32)
activated2_0_negated = sub(zero, gate2_0)
activated2_0_minus_abs = min(gate2_0, activated2_0_negated)
activated2_0_a = qexp(activated2_0_minus_abs, 16)
activated2_0_denominator = add(one, activated2_0_a)
activated2_0_x_a = qmul(gate2_0, activated2_0_a, 16)
