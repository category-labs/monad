mlp_in3_2 = qmul(mlp_in3_2_normed, rms_ffn_2, 16)
gate3_2 = qmatmul(mlp_in3_2, w1_2, 16, int32)
up3_2 = qmatmul(mlp_in3_2, w3_2, 16, int32)
activated3_2_negated = sub(zero, gate3_2)
