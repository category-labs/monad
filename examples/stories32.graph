activated0_0_denominator = add(one, activated0_0_a)
activated0_0_x_a = qmul(gate0_0, activated0_0_a, 16)
activated0_0_positive = ge(gate0_0, zero)
activated0_0_numerator = where(activated0_0_positive, gate0_0, activated0_0_x_a)
activated0_0 = qdiv(activated0_0_numerator, activated0_0_denominator, 16)
gated0_0 = qmul(activated0_0, up0_0, 16)
