final15 = qmul(final15_normed, rms_final_0, 16)
final_column15 = reshape(final15, [64, 1])
logits15 = qmatmul(token_embeddings, final_column15, 16, int32)
likeliest15 = argmax(logits15)
given15 = gather(prompt, position15, 0)
in_prompt15 = greater(length, position15)
token16 = where(in_prompt15, given15, likeliest15)
story15 = concat(story14, token16, 0)
# Position 16: its token's embedding, and its angles
position16 = literal(int32[1] [16])
cos16 = literal(int32[8] [-62761, -62761, -1914, -1914, 64699, 64699, 65528, 65528])
sin16 = literal(int32[8] [18868, -18868, -65508, 65508, -10441, 10441, -1049, 1049])
