# Position 14: the next token, the prompt's if it has one there, otherwise the likeliest. The classifier is the embeddings
final14_squares = qmul(after_mlp14_4, after_mlp14_4, 16)
final14_total = reducesum(final14_squares, 1)
final14_mean = div(final14_total, 64)
final14_shifted = add(final14_mean, epsilon)
final14_scale = qinvsqrt(final14_shifted, 16)
final14_normed = qmul(after_mlp14_4, final14_scale, 16)
final14 = qmul(final14_normed, rms_final_0, 16)
final_column14 = reshape(final14, [64, 1])
logits14 = qmatmul(token_embeddings, final_column14, 16, int32)
likeliest14 = argmax(logits14)
given14 = gather(prompt, position14, 0)
in_prompt14 = greater(length, position14)
token15 = where(in_prompt14, given14, likeliest14)
story14 = concat(story13, token15, 0)
# Position 15: its token's embedding, and its angles
position15 = literal(int32[1] [15])
cos15 = literal(int32[8] [-49787, -49787, 4636, 4636, 64800, 64800, 65529, 65529])
sin15 = literal(int32[8] [-42617, 42617, -65372, 65372, -9794, 9794, -983, 983])
