attention0_1 = reshape(heads_out0_1, [1, 64])
projected0_1 = qmatmul(attention0_1, wo_1, 16, int32)
after_attention0_1 = add(projected0_1, after_mlp0_0)
# Position 0, layer 1: the MLP, w2(silu(w1(x)) * w3(x))
mlp_in0_1_squares = qmul(after_attention0_1, after_attention0_1, 16)
