diff --git a/immer/detail/hamts/bits.hpp b/immer/detail/hamts/bits.hpp
--- a/immer/detail/hamts/bits.hpp
+++ b/immer/detail/hamts/bits.hpp
@@ -11,6 +11,57 @@
 #include <cstddef>
 #include <cstdint>
 
+#ifndef MONAD_POPCOUNT_INLINE_MEASUREMENT
+#define MONAD_POPCOUNT_INLINE_MEASUREMENT
+// riscv64ima has no `cpop`, so the __builtin_popcount{,ll} below become
+// 30-instruction libgcc calls, and immer's HAMT makes 41,909 of them per
+// block (25551991) — 1,257,270 steps, 0.96 % of the guest.
+//
+// Inline the SWAR instead. On ZisK also fetch its four constants rather than
+// let gcc rebuild each 64-bit immediate from lui/addi/slli/add at every site:
+// 29 instructions against 19, and an 8-aligned 8-byte load is 16 against 68
+// for each instruction it replaces. 820 COST per call, 34.4 M, 0.17 %.
+//
+// Self-contained on purpose: immer must not reach into category/.
+namespace monad_popcount_inline {
+
+alignas(8) inline constexpr unsigned long long POPC_K[4] = {
+    0x5555555555555555ull,
+    0x3333333333333333ull,
+    0x0F0F0F0F0F0F0F0Full,
+    0x0101010101010101ull};
+
+[[gnu::always_inline]] inline constexpr unsigned long long
+kk(unsigned long long const& c) noexcept
+{
+#if defined(MONAD_ZKVM_ZISK)
+    if !consteval {
+        unsigned long long v;
+        asm("ld %0, %1" : "=r"(v) : "m"(c));
+        return v;
+    }
+#endif
+    return c;
+}
+
+[[gnu::always_inline]] inline constexpr int p64(unsigned long long x) noexcept
+{
+    unsigned long long const k3 = kk(POPC_K[1]);
+    x = x - ((x >> 1) & kk(POPC_K[0]));
+    x = (x & k3) + ((x >> 2) & k3);
+    x = (x + (x >> 4)) & kk(POPC_K[2]);
+    return (int) ((x * kk(POPC_K[3])) >> 56);
+}
+
+template <typename T>
+[[gnu::always_inline]] inline constexpr int pc(T x) noexcept
+{
+    return p64((unsigned long long) x);
+}
+
+} // namespace monad_popcount_inline
+#endif
+
 #if defined(_MSC_VER)
 #include <intrin.h> // __popcnt
 #endif
@@ -89,7 +140,7 @@
 #if defined(_MSC_VER)
     return __popcnt(x);
 #else
-    return __builtin_popcount(x);
+    return monad_popcount_inline::pc(x);
 #endif
 #else
     return popcount_fallback(x);
@@ -108,7 +159,7 @@
            popcount(static_cast<std::uint32_t>(x));
 #endif
 #else
-    return __builtin_popcountll(x);
+    return monad_popcount_inline::pc(x);
 #endif
 #else
     return popcount_fallback(x);
