 #if defined(_MSC_VER)
     return __popcnt(x);
 #else
-    return __builtin_popcount(x);
+    return monad_popcount_inline::pc(x);
 #endif
 #else
     return popcount_fallback(x);
@@ -108,7 +125,7 @@ inline count_t popcount(std::uint64_t x)
