+/* ZisK zkVM DMA lowering ---------------------------------------------------
+
+   The ZisK transpiler folds a `csrs 0x813, src` marker immediately followed by
+   an `add`/`addi` writing x0 into a single memcpy operation, the way x86 folds
+   `rep movsb`.  The two instructions must stay adjacent, so each form is one
+   define_insn whose template prints both: an insn is never split or scheduled
+   apart, which is what the LLVM lowering achieves with a Pseudo expanded in the
+   AsmPrinter.
+
+   Two forms, and they do NOT cost the same on ZisK:
+
+     csrs 0x813,src ; addi x0,dst,IMM  -> one zisk instruction, the count rides
+                                          in the extended argument
+     csrs 0x813,src ; add  x0,dst,reg  -> two, the first *writes* the count to
+                                          EXTRA_PARAMS_ADDR
+
+   so a compile-time length is worth preferring wherever it fits simm12.
+
+   Overlapping ranges are fine: the machine's memcpy detects overlap and copies
+   through a temporary, which is why movmem (memmove) shares this path.  */
+
+/* Largest count the addi form can carry.  */
+#define ZISK_DMA_MAX_IMM 2047
+
+bool
+riscv_zisk_expand_cpymem (rtx dest, rtx src, rtx length)
+{
+  if (!TARGET_ZISK_DMA)
+    return false;
+
+  /* A volatile block move has to keep its exact access pattern; the precompile
+     performs the copy in one opaque step, so leave those to the generic code.  */
+  if (MEM_VOLATILE_P (dest) || MEM_VOLATILE_P (src))
+    return false;
+
+  rtx dst_addr = force_reg (Pmode, XEXP (dest, 0));
+  rtx src_addr = force_reg (Pmode, XEXP (src, 0));
+
+  if (CONST_INT_P (length))
+    {
+      unsigned HOST_WIDE_INT n = UINTVAL (length);
+      if (n == 0)
+	return true;
+      if (n <= ZISK_DMA_MAX_IMM)
+	{
+	  if (Pmode == DImode)
+	    emit_insn (gen_riscv_zisk_cpymem_immdi (dst_addr, src_addr,
+						    GEN_INT (n)));
+	  else
+	    emit_insn (gen_riscv_zisk_cpymem_immsi (dst_addr, src_addr,
+						    GEN_INT (n)));
+	  return true;
+	}
+    }
+
+  rtx len = force_reg (Pmode, length);
+  if (Pmode == DImode)
+    emit_insn (gen_riscv_zisk_cpymem_regdi (dst_addr, src_addr, len));
+  else
+    emit_insn (gen_riscv_zisk_cpymem_regsi (dst_addr, src_addr, len));
+  return true;
+}
+
+/* memset.  Two marker forms, both one zisk operation:
+
+     csrsi 0x816,2 ; addi x0,dst,COUNT ; addi x0,dst,FILL   (both immediate)
+     csrs  0x816,dst ; addi x0,count,FILL                   (count in a register)
+
+   The fill byte always rides in an addi immediate, so a run-time fill cannot use
+   the precompile at all and falls back to the generic code (which reaches the
+   ziskos thunk and its 256-entry jump table).  */
+
+bool
+riscv_zisk_expand_setmem (rtx dest, rtx length, rtx value)
+{
+  if (!TARGET_ZISK_DMA)
+    return false;
+  if (MEM_VOLATILE_P (dest))
+    return false;
+  if (!CONST_INT_P (value))
+    return false;
+
+  rtx fill = GEN_INT (UINTVAL (value) & 0xff);
+  rtx dst_addr = force_reg (Pmode, XEXP (dest, 0));
+
+  if (CONST_INT_P (length))
+    {
+      unsigned HOST_WIDE_INT n = UINTVAL (length);
+      if (n == 0)
+	return true;
+      if (n <= ZISK_DMA_MAX_IMM)
+	{
+	  if (Pmode == DImode)
+	    emit_insn (gen_riscv_zisk_setmem_immdi (dst_addr, GEN_INT (n), fill));
+	  else
+	    emit_insn (gen_riscv_zisk_setmem_immsi (dst_addr, GEN_INT (n), fill));
+	  return true;
+	}
+    }
+
+  rtx len = force_reg (Pmode, convert_to_mode (Pmode, length, 1));
+  if (Pmode == DImode)
+    emit_insn (gen_riscv_zisk_setmem_regdi (dst_addr, len, fill));
+  else
+    emit_insn (gen_riscv_zisk_setmem_regsi (dst_addr, len, fill));
+  return true;
+}
+
+/* memcmp.  The result register rides on the marker's csrrs, and the machine
+   returns (byte_a - byte_b) sign extended to 64 bits, so it is already a
+   canonical SImode value and needs no sext.w.  */
+
+bool
+riscv_zisk_expand_cmpmem (rtx result, rtx op1, rtx op2, rtx length)
+{
+  if (!TARGET_ZISK_DMA)
+    return false;
+  if (MEM_VOLATILE_P (op1) || MEM_VOLATILE_P (op2))
+    return false;
+
+  rtx a_addr = force_reg (Pmode, XEXP (op1, 0));
+  rtx b_addr = force_reg (Pmode, XEXP (op2, 0));
+
+  if (CONST_INT_P (length))
+    {
+      unsigned HOST_WIDE_INT n = UINTVAL (length);
+      if (n == 0)
+	{
+	  emit_move_insn (result, const0_rtx);
+	  return true;
+	}
+      if (n <= ZISK_DMA_MAX_IMM)
+	{
+	  if (Pmode == DImode)
+	    emit_insn (gen_riscv_zisk_cmpmem_immdi (result, a_addr, b_addr,
+						    GEN_INT (n)));
+	  else
+	    emit_insn (gen_riscv_zisk_cmpmem_immsi (result, a_addr, b_addr,
+						    GEN_INT (n)));
+	  return true;
+	}
+    }
+
+  rtx len = force_reg (Pmode, convert_to_mode (Pmode, length, 1));
+  if (Pmode == DImode)
+    emit_insn (gen_riscv_zisk_cmpmem_regdi (result, a_addr, b_addr, len));
+  else
+    emit_insn (gen_riscv_zisk_cmpmem_regsi (result, a_addr, b_addr, len));
+  return true;
+}
