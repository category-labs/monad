+;; Add in 64 bits with a zero-extended immediate, preserving the result
+;; modulo 256. Small nonnegative operands can use ZisK's FROP path;
+;; stores are cheaper when the full result also fits in one byte.
+;; This does not clear upper bits in register operands or overflowing sums.
+(define_expand "addqi3"
+  [(set (match_operand:QI          0 "register_operand")
+	(plus:QI (match_operand:QI 1 "register_operand")
+		 (match_operand:QI 2 "arith_operand")))]
+  "TARGET_64BIT && TARGET_ZISK_CLEAN_BYTE_STORES"
+{
+  rtx t = gen_reg_rtx (DImode);
+  rtx op2 = CONST_INT_P (operands[2])
+	    ? GEN_INT (INTVAL (operands[2]) & 0xff)
+	    : gen_lowpart (DImode, operands[2]);
+  emit_insn (gen_adddi3 (t, gen_lowpart (DImode, operands[1]), op2));
+  emit_move_insn (operands[0], gen_lowpart (QImode, t));
+  DONE;
+})
